#!/bin/bash

#SBATCH --job-name=plasmid_mobsuite
#SBATCH --mail-user=tifwan@umich.edu
#SBATCH --mail-type=BEGIN,FAIL,END,REQUEUE
#SBATCH --export=ALL
#SBATCH --partition=standard
#SBATCH --account=esnitkin1
#SBATCH --nodes=1 --ntasks=1 --cpus-per-task=1 --mem=32g --time=30:15:00

## Note: Change the mail-user, account, and SBATCH mem/time requirements as you see fit

# ---- enable internet on compute nodes ----
source /etc/profile.d/http_proxy.sh      # ← add here

# run this first before running the sbat
#snakemake -s workflow/Snakefile --use-conda --conda-create-envs-only --cores 1
# load modules
module load snakemake Bioinformatics singularity mamba

# make sure log dir exists
mkdir -p slurm_out

# run snakemake
snakemake -s workflow/Snakefile -j 999 \
  --use-singularity \
  --singularity-args "-B /nfs/turbo:/nfs/turbo -B /scratch:/scratch"\
  --cluster-config config/cluster.json \
  --cluster "sbatch -A {cluster.account} -p {cluster.partition} -N {cluster.nodes} -t {cluster.walltime} -c {cluster.procs} --mem-per-cpu {cluster.pmem} --output=slurm_out/slurm-%j.out" \
  --configfile config/config.yaml --latency-wait 1000 --nolock
